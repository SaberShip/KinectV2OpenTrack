<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>KinectV2OpenTrack</RootNamespace>
    <AssemblyName>KinectV2OpenTrack</AssemblyName>
    <!-- Microsoft.Kinect.Face is x64-only; run as a 64-bit process -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Assembly attributes come from Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Kinect">
      <HintPath>C:\Program Files\Microsoft SDKs\Kinect\v2.0_1409\Assemblies\Microsoft.Kinect.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Kinect.Face">
      <HintPath>C:\Program Files\Microsoft SDKs\Kinect\v2.0_1409\Redist\Face\x64\Microsoft.Kinect.Face.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The HD face runtime data must sit next to the executable -->
  <ItemGroup>
    <None Update="NuiDatabase\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
